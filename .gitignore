datasets/
third_party/
singularity/
*.sif

# Videos & media (never commit large binaries)
*.mp4
*.MP4
*.avi
*.mov
*.mkv
*.gif

# Generated data files
*.npz
*.npy

# ── Input / Output ──────────────────────────────────────────
# Keep folder structure with .gitkeep, ignore contents (videos, JSONs, etc.)
input/*
!input/.gitkeep
!input/README.md

output/*
!output/.gitkeep

# ── Allow specific demo files ───────────────────────────────

# config/config.yaml is runtime state, rewritten on every run.
# Untracked since the reproducibility refactor; removed entirely in T4.1
# (see docs/REFACTOR_PLAN.md).
config/config.yaml

# Accidentally committed empty file, removed from the index
conda

# Allow all files in the demo folder.
#
# Anchored with a leading slash, and that matters: a bare `demo/` matches a
# directory of that name at ANY depth, so it also re-included output/demo/ and
# defeated the `output/*` rule above. A demo run whose output directory happens
# to be called `demo` -- which is exactly what the container's `demo` shortcut
# writes -- then got committed, 43 files and 42 MB of generated JSON.
!/demo/
!/demo/**

# ── Misc junk ───────────────────────────────────────────────
*.pub
*.pub.*
*.log
tmp_vis.ipynb
tmp.sh

# Windows alternate-data-stream metadata (created on WSL when copying from Windows)
*:Zone.Identifier
